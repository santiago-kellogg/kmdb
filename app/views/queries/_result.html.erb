<% if query.error? %>
  <p class="p-3 rounded bg-red-50 border border-red-300 text-red-900 text-sm font-mono"><%= query.error %></p>
<% else %>
  <p class="text-sm text-stone-600 mb-2">
    <%= pluralize(query.row_count, "row") %><%= ", showing the first #{Query::MAX_ROWS}" if query.truncated? %>
  </p>
  <% if query.columns.any? %>
    <div class="overflow-auto max-h-80 border border-stone-200 rounded">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="bg-stone-800 text-white sticky top-0">
            <% query.columns.each do |column| %>
              <th class="px-3 py-2 text-left font-semibold"><%= column %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% query.visible_rows.each do |row| %>
            <tr class="border-b border-stone-200 even:bg-stone-50">
              <% row.each do |value| %>
                <td class="px-3 py-1.5 whitespace-nowrap"><%= value %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
