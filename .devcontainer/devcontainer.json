{
  "name": "kmdb",
  "image": "ruby:4.0.5",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "kmdb app", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["vortizhe.simple-ruby-erb", "MS-vsliveshare.vsliveshare"],
      "settings": {
        "editor.stickyScroll.enabled": true,
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "files.associations": { "*.sql": "sql" }
      }
    }
  }
}
